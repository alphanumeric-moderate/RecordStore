--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CodeNum = require(ReplicatedStorage:WaitForChild("CodeNum"))
local CodeNumFormatter = require(ServerScriptService:WaitForChild("CodeNumFormatter"))

assert(CodeNum.VERSION == "0.6.0")
assert(CodeNumFormatter.format(999) == "999")
assert(CodeNumFormatter.format(1_000) == "1K")
assert(CodeNumFormatter.format(1_250) == "1.25K")
assert(CodeNumFormatter.format(1_000_000) == "1M")
assert(CodeNumFormatter.format(999_999) == "1M")
assert(CodeNumFormatter.format(1_000_000_000_000) == "1T")
assert(CodeNumFormatter.format(-1_500_000_000) == "-1.5B")
assert(CodeNumFormatter.format(math.huge) == "Infinity")
assert(CodeNumFormatter.format(-math.huge) == "-Infinity")
assert(CodeNumFormatter.format(0 / 0) == "NaN")
assert(CodeNumFormatter.format("Infinity") == "Infinity")
assert(CodeNumFormatter.format("-Infinity") == "-Infinity")
assert(CodeNumFormatter.format("NaN") == "NaN")

assert(CodeNumFormatter.format(1_200_000, { decimals = 0 }) == "1M")
assert(CodeNumFormatter.format(1_200_000, { decimals = 3, trim_trailing_zeros = false }) == "1.200M")
assert(CodeNumFormatter.format(1_200_000, { decimals = 3 }) == "1.2M")
assert(CodeNumFormatter.format(1, { decimals = 3, trim_trailing_zeros = false }) == "1.000")

local precise = CodeNum.fromInteger("123456789012345678901234567890")
assert(CodeNum.isPrecise(precise))
local precise_payload = CodeNum.encode(precise)
assert(string.match(precise_payload, "^CN2|P|") ~= nil)
assert(CodeNum.toString(CodeNumFormatter.to_value(precise_payload)) == CodeNum.toString(precise))
assert(CodeNumFormatter.format(precise_payload) == CodeNumFormatter.format(precise))

local large = CodeNum.fromScientific(1.25, "1000")
assert(CodeNumFormatter.format(large) == "1.25e1000")
assert(CodeNumFormatter.format(CodeNum.fromScientific(1, "600")) ~= "")
assert(#CodeNumFormatter.getSuffixes() > 200)
assert(not pcall(function() CodeNumFormatter.format(1, { decimals = 7 }) end))
assert(not pcall(function() CodeNumFormatter.format(1, { unknown = true }) end))

print("[CodeNumFormatter] native, extended-range, and special-value regressions passed")
